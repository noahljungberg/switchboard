{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "SWITCHBOARD_ENV_FILE=\"$HOME/.config/switchboard/env\" node \"$HOME/.config/switchboard/switchboard.mjs\" hook codex", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "SWITCHBOARD_ENV_FILE=\"$HOME/.config/switchboard/env\" node \"$HOME/.config/switchboard/switchboard.mjs\" hook codex", "timeout": 5 }] }
    ]
  }
}
